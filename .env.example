# 이 파일을 .env 로 복사한 뒤 값만 채워 넣으면 된다.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (bash)
# .env 자체는 .gitignore 에 있어 커밋되지 않는다. 실제 값은 여기 적지 말 것.

# ---------------------------------------------------------------------------
# [필수] KRX 정보데이터시스템 계정 (data.krx.co.kr 무료 회원가입)
# ---------------------------------------------------------------------------
# ETF 시세와 구성종목(PDF) 조회에 필요하다. 비어 있으면 main.py 가 '휴장일' 처럼
# 보이는 조회 오류로 실패하므로, 먼저 `python main.py --check` 로 로그인을 확인하라.
#
# pykrx 자체는 KRX_ID / KRX_PW 라는 이름만 읽지만, main.py 가 아래 이름의 값을
# 그 이름으로 옮겨 주므로 여기에만 적어두면 된다.
KRX_LOGIN_ID=
KRX_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# [필수] wkhtmltoimage 실행 파일 경로 - PNG 생성
# ---------------------------------------------------------------------------
# https://wkhtmltopdf.org/downloads.html 에서 wkhtmltopdf 를 설치하면 함께 깔린다.
# 형제 프로젝트(krx-topsector-report 등)와 같은 이름이라 값을 그대로 옮겨도 된다.
#   예) WKHTMLTOIMAGE_PATH=C:\Program Files\wkhtmltopdf\bin\wkhtmltoimage.exe
WKHTMLTOIMAGE_PATH=

# ---------------------------------------------------------------------------
# [--send 시 필수] MQWAY 게시 대상 사이트
# ---------------------------------------------------------------------------
# 스킴과 호스트까지만 적는다. 끝의 /api 는 코드가 붙인다.
#   BASE_URL=http://localhost   ->  http://localhost/api/board-research
# 게시판(board-research), 작성자(admin), 카테고리(섹터분석)는 고정값이라
# 환경변수로 받지 않는다. main.py 의 POST_CATEGORY / POST_WRITER 를 본다.
BASE_URL=

# ---------------------------------------------------------------------------
# [--send 시 필수] 텔레그램 - 보드 PNG 와 실패 알림
# ---------------------------------------------------------------------------
# BOT_TOKEN 은 @BotFather 에서, CHAT_ID 는 봇을 초대한 방에서 확인한다.
# 형제 프로젝트 krx-daily-brief 와 같은 이름이라 값을 그대로 옮겨도 된다.
TELEGRAM_BOT_TOKEN=
# 보드 PNG 가 가는 운영 방
TELEGRAM_CHAT_ID=
# 실패 알림이 가는 방. 비우면 위 방으로 간다
TELEGRAM_CHAT_TEST_ID=
